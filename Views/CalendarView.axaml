<!-- Views/CalendarView.axaml -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ShiftSchedulerDesktop.ViewModels"
    xmlns:models="using:Models"
    x:Class="ShiftSchedulerDesktop.Views.CalendarView"
    x:DataType="vm:CalendarViewModel"
>

    <UserControl.Styles>
        <!-- Employee card in bank -->
        <Style Selector="Border.employee-card">
            <Setter Property="Background" Value="#4A90D9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #50000000" />
        </Style>
        <Style Selector="Border.employee-card:pointerover">
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="BoxShadow" Value="0 2 6 0 #60000000" />
        </Style>

        <!-- Day row -->
        <Style Selector="Border.day-row">
            <Setter Property="BorderBrush" Value="#3d3d3d" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Background" Value="#1e1e1e" />
        </Style>
        <Style Selector="Border.day-row.drag-over">
            <Setter Property="Background" Value="#2d4a6d" />
        </Style>

        <!-- Shift block -->
        <Style Selector="Border.shift-block">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #50000000" />
        </Style>
        <Style Selector="Border.shift-block:pointerover">
            <Setter Property="BoxShadow" Value="0 2 6 0 #60000000" />
        </Style>

        <!-- Resize handle indicators -->
        <Style Selector="Border.resize-handle">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Cursor" Value="SizeWestEast" />
        </Style>
        <Style Selector="Border.shift-block:pointerover Border.resize-handle">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="#80FFFFFF" />
        </Style>
        <Style Selector="Border.resize-handle:pointerover">
            <Setter Property="Background" Value="#B0FFFFFF" />
        </Style>

        <!-- Hour column header -->
        <Style Selector="Border.hour-header">
            <Setter Property="Background" Value="#2d2d2d" />
            <Setter Property="BorderBrush" Value="#3d3d3d" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- Day label -->
        <Style Selector="Border.day-label">
            <Setter Property="Background" Value="#2d2d2d" />
            <Setter Property="BorderBrush" Value="#3d3d3d" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="#1a1a1a">

        <!-- Header with Store Selector -->
        <Border
            Grid.Row="0"
            Background="#252525"
            Padding="16"
            BorderBrush="#3d3d3d"
            BorderThickness="0,0,0,1"
        >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        Text="Store:"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#e0e0e0"
                    />
                    <ComboBox
                        ItemsSource="{Binding Stores}"
                        SelectedItem="{Binding SelectedStore}"
                        MinWidth="200"
                    >
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:Store">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding SaveStatusMessage}"
                        Foreground="#27AE60"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                    />
                    <Button
                        Command="{Binding SaveScheduleCommand}"
                        Content="Save Schedule"
                        Background="#27AE60"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="16,8"
                        CornerRadius="4"
                    />
                    <Button
                        Command="{Binding ExportPdfCommand}"
                        Content="Export PDF"
                        Background="#3498DB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="16,8"
                        CornerRadius="4"
                    />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Employee Bank (drop shifts here to delete) -->
        <Border
            Grid.Row="1"
            Name="EmployeeBankBorder"
            Background="#252525"
            Padding="12"
            BorderBrush="#3d3d3d"
            BorderThickness="0,0,0,1"
            DragDrop.AllowDrop="True"
        >
            <Grid RowDefinitions="Auto,Auto">
                <TextBlock
                    Grid.Row="0"
                    Text="Employees"
                    FontWeight="SemiBold"
                    Foreground="#e0e0e0"
                    Margin="4,0,0,8"
                />
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                >
                    <ItemsControl ItemsSource="{Binding StoreEmployees}" Name="EmployeeBank">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:Employee">
                                <Border Classes="employee-card" Tag="{Binding}">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                    />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Schedule Grid -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
        >
            <Grid Name="ScheduleGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Hour headers -->
                    <RowDefinition Height="*" /> <!-- Day rows -->
                </Grid.RowDefinitions>

                <!-- Hour Headers Row -->
                <Border Grid.Row="0" Background="#2d2d2d">
                    <StackPanel Orientation="Horizontal">
                        <!-- Empty corner cell -->
                        <Border Classes="day-label">
                            <TextBlock Text="" Width="40" />
                        </Border>
                        <!-- Hour column headers -->
                        <ItemsControl ItemsSource="{Binding HourSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="hour-header">
                                        <TextBlock
                                            Text="{Binding}"
                                            FontWeight="Medium"
                                            Foreground="#b0b0b0"
                                            HorizontalAlignment="Center"
                                        />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Day Rows -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" Name="DayRowsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ScheduleDay">
                            <Border
                                Classes="day-row"
                                Classes.drag-over="{Binding IsDragOver}"
                                DragDrop.AllowDrop="True"
                            >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Day Label -->
                                    <Border Grid.Column="0" Classes="day-label">
                                        <TextBlock
                                            Text="{Binding DayName}"
                                            FontWeight="SemiBold"
                                            Foreground="#b0b0b0"
                                            VerticalAlignment="Center"
                                        />
                                    </Border>

                                    <!-- Time Grid with Shifts -->
                                    <ItemsControl
                                        Grid.Column="1"
                                        ItemsSource="{Binding Shifts}"
                                        MinHeight="60"
                                        DragDrop.AllowDrop="True"
                                        Background="Transparent"
                                    >
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ScheduleShift">
                                                <Border
                                                    Classes="shift-block"
                                                    Background="{Binding Color}"
                                                    Height="50"
                                                    Tag="{Binding}"
                                                >
                                                    <Grid>
                                                        <!-- Left resize handle -->
                                                        <Border
                                                            Classes="resize-handle"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Stretch"
                                                            Margin="2,6"
                                                        />
                                                        <!-- Right resize handle -->
                                                        <Border
                                                            Classes="resize-handle"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Margin="2,6"
                                                        />
                                                        <!-- Content -->
                                                        <StackPanel
                                                            Orientation="Vertical"
                                                            VerticalAlignment="Center"
                                                            Margin="12,4"
                                                        >
                                                            <TextBlock
                                                                Text="{Binding EmployeeName}"
                                                                Foreground="White"
                                                                FontWeight="SemiBold"
                                                                FontSize="16"
                                                            />
                                                            <TextBlock
                                                                Text="{Binding TimeDisplay}"
                                                                Foreground="White"
                                                                Opacity="0.85"
                                                                FontSize="14"
                                                            />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Employee Availability Section -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <!-- Availability Header -->
            <Border
                Grid.Row="0"
                Background="#252525"
                Padding="12"
                BorderBrush="#3d3d3d"
                BorderThickness="0,1,0,1"
            >
                <TextBlock
                    Text="Employee Availability"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Foreground="#e0e0e0"
                />
            </Border>

            <!-- Availability Grid -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
            >
                <Grid Name="AvailabilityGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Hour headers -->
                        <RowDefinition Height="*" /> <!-- Day rows -->
                    </Grid.RowDefinitions>

                    <!-- Hour Headers Row -->
                    <Border Grid.Row="0" Background="#2d2d2d">
                        <StackPanel Orientation="Horizontal">
                            <!-- Empty corner cell -->
                            <Border Classes="day-label">
                                <TextBlock Text="" Width="40" />
                            </Border>
                            <!-- Hour column headers -->
                            <ItemsControl ItemsSource="{Binding HourSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="hour-header">
                                            <TextBlock
                                                Text="{Binding}"
                                                FontWeight="Medium"
                                                Foreground="#b0b0b0"
                                                HorizontalAlignment="Center"
                                            />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Day Rows -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding AvailabilityDays}" Name="AvailabilityDayRowsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ScheduleDay">
                                <Border
                                    Classes="day-row"
                                    Classes.drag-over="{Binding IsDragOver}"
                                    DragDrop.AllowDrop="True"
                                >
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Day Label -->
                                        <Border Grid.Column="0" Classes="day-label">
                                            <TextBlock
                                                Text="{Binding DayName}"
                                                FontWeight="SemiBold"
                                                Foreground="#b0b0b0"
                                                VerticalAlignment="Center"
                                            />
                                        </Border>

                                        <!-- Time Grid with Availability Blocks -->
                                        <ItemsControl
                                            Grid.Column="1"
                                            ItemsSource="{Binding Shifts}"
                                            MinHeight="60"
                                            DragDrop.AllowDrop="True"
                                            Background="Transparent"
                                        >
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ScheduleShift">
                                                    <Border
                                                        Classes="shift-block"
                                                        Background="{Binding Color}"
                                                        Height="50"
                                                        Tag="{Binding}"
                                                    >
                                                        <Grid>
                                                            <!-- Left resize handle -->
                                                            <Border
                                                                Classes="resize-handle"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Stretch"
                                                                Margin="2,6"
                                                            />
                                                            <!-- Right resize handle -->
                                                            <Border
                                                                Classes="resize-handle"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Stretch"
                                                                Margin="2,6"
                                                            />
                                                            <!-- Content -->
                                                            <StackPanel
                                                                Orientation="Vertical"
                                                                VerticalAlignment="Center"
                                                                Margin="12,4"
                                                            >
                                                                <TextBlock
                                                                    Text="{Binding EmployeeName}"
                                                                    Foreground="White"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="16"
                                                                />
                                                                <TextBlock
                                                                    Text="{Binding TimeDisplay}"
                                                                    Foreground="White"
                                                                    Opacity="0.85"
                                                                    FontSize="14"
                                                                />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
